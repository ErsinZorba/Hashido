{
  "$comment": "Hashido (APFS for Windows) raporlama olayı: uygulama (src/Apfs.Windows/Reporting/ReportSchema.cs) ve Worker (P3) AYNI dosyayı uygular. Yalnız şu anahtar sözcükler kullanılır: $ref (bu dosyanın üst düzey tanımlarından birinin adı: envelope, event, disk), type, properties, required, additionalProperties (false), enum, const, pattern, maxLength, minimum, maximum, items, maxItems. Tanımlanmamış her alan reddedilir. Sayısal 'Log2' alanları aralıktır: 0 → 0, aksi hâlde değerin ikili basamak sayısı (1 → 1, 2-3 → 2, 4-7 → 3, …); tam değer asla gönderilmez. Ad, seri numarası, UUID, tam boyut, parola/anahtar/ipucu, bilgisayar/kullanıcı adı, yol, istisna iletisi ve kalıcı cihaz kimliği için alan YOKTUR.",
  "envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["events"],
    "properties": {
      "events": { "type": "array", "maxItems": 50, "items": { "$ref": "event" } }
    }
  },
  "event": {
    "type": "object",
    "additionalProperties": false,
    "required": ["v", "app", "os", "osArch", "procArch", "lang", "type", "result", "day"],
    "properties": {
      "v": { "const": 1 },
      "test": { "type": "boolean" },
      "app": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
      "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
      "os": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,6}$" },
      "osArch": { "enum": ["x64", "arm64", "x86", "other"] },
      "procArch": { "enum": ["x64", "arm64", "x86", "other"] },
      "lang": { "enum": ["tr", "en", "de", "fr", "es", "pt-BR", "it", "ja", "zh-Hans", "ko", "other"] },
      "process": { "enum": ["service", "tray"] },
      "type": { "enum": ["mount", "unlock", "write-enable", "write-session", "eject", "disk-changed", "crash"] },
      "result": { "enum": ["ok", "fail", "refused", "busy", "detached", "abandoned"] },
      "code": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]{0,47}$" },
      "gate": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^(Gate|Write)\\.[A-Za-z]{1,40}$" } },
      "durLog2": { "type": "integer", "minimum": 0, "maximum": 64 },
      "day": { "type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$" },
      "disk": { "$ref": "disk" },
      "volumes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mounted": { "type": "integer", "minimum": 0, "maximum": 100 },
          "locked": { "type": "integer", "minimum": 0, "maximum": 100 },
          "hidden": { "type": "integer", "minimum": 0, "maximum": 100 },
          "failed": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      },
      "write": {
        "type": "object",
        "additionalProperties": false,
        "required": ["close"],
        "properties": {
          "close": { "enum": ["read-only", "eject", "removed", "changed", "service-stop", "failed"] },
          "commitsLog2": { "type": "integer", "minimum": 0, "maximum": 64 },
          "bytesLog2": { "type": "integer", "minimum": 0, "maximum": 64 },
          "opsLog2": { "type": "integer", "minimum": 0, "maximum": 64 }
        }
      },
      "crash": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exType"],
        "properties": {
          "exType": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.`+]{0,119}$" },
          "innerType": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.`+]{0,119}$" },
          "frames": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "pattern": "^Apfs\\.[A-Za-z0-9_.`<>$|+,]{1,180}\\+0x[0-9a-f]{1,6}$" }
          }
        }
      }
    }
  },
  "disk": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bus": { "enum": ["usb", "sata", "nvme", "sd", "mmc", "sas", "scsi", "ata", "raid", "vhd", "virtual", "image", "other"] },
      "sector": { "type": "integer", "minimum": 0, "maximum": 65536 },
      "scheme": { "enum": ["gpt", "none"] },
      "apfsParts": { "type": "integer", "minimum": 0, "maximum": 64 },
      "blockSize": { "type": "integer", "minimum": 0, "maximum": 1048576 },
      "sizeLog2": { "type": "integer", "minimum": 0, "maximum": 64 },
      "nxFeatures": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
      "nxIncompat": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
      "nxRoCompat": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
      "swCrypto": { "type": "boolean" },
      "unreadableVolumes": { "type": "integer", "minimum": 0, "maximum": 100 },
      "volumes": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": { "enum": ["none", "system", "user", "recovery", "vm", "preboot", "installer", "data", "baseband", "update", "xart", "hardware", "backup", "sidecar", "enterprise", "prelogin", "other"] },
            "enc": { "enum": ["none", "onekey", "perfile", "other"] },
            "caseSensitive": { "type": "boolean" },
            "snapshots": { "type": "boolean" },
            "filesLog2": { "type": "integer", "minimum": 0, "maximum": 64 },
            "lastWriter": { "type": "string", "maxLength": 32, "pattern": "^([a-z_]{1,24} \\([0-9]{1,5}(\\.[0-9]{1,5}){0,4}\\)|apfs-for-windows [0-9]{1,3}(\\.[0-9]{1,3}){1,3})$" },
            "features": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "incompat": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "roCompat": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        }
      }
    }
  }
}
