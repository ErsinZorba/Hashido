<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Unicode normalizasyonu (NFD) için ICU/NLS gerekli; invariant moda geçilmemeli. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.4.0</Version>
    <Authors>Ersin Zorba</Authors>
    <!-- Ürün adı: kaynağı src/Apfs.Windows/Branding.cs (ProductName); burası ve .iss AppName aynı kalmalı (BrandingTests). -->
    <Product>Hashido</Product>
    <Copyright>Copyright (c) 2026 Ersin Zorba</Copyright>
  </PropertyGroup>
</Project>
