<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Apfs.Windows</RootNamespace>
    <!-- Nötr kaynak dili İngilizce: çevirisi olmayan dil İngilizce görünür (Localization/Languages.cs). -->
    <NeutralLanguage>en</NeutralLanguage>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apfs.Core\Apfs.Core.csproj" />
    <InternalsVisibleTo Include="Apfs.Tests" />
    <!-- Raporlama izin listesi: Worker ile ORTAK dosya (worker/schema.json); uygulama her olayı göndermeden önce buna göre denetler. -->
    <EmbeddedResource Include="..\..\worker\schema.json" LogicalName="report-schema.json" />
  </ItemGroup>
</Project>
